{
  "experiment_name": "price-tag-baseline",
  "dataset": {
    "train_manifest": "data/manifests/train.jsonl",
    "val_manifest": "data/manifests/val.jsonl",
    "image_root": "data/images",
    "num_workers": 4
  },
  "model": {
    "backbone": "resnet18",
    "num_classes": 8,
    "image_size": 224,
    "dropout": 0.1
  },
  "optimizer": {
    "name": "adamw",
    "lr": 0.0003,
    "weight_decay": 0.0001
  },
  "train": {
    "seed": 1337,
    "device": "cuda",
    "batch_size": 32,
    "epochs": 10,
    "output_dir": "outputs/price-tag-baseline",
    "log_every_n_steps": 10
  }
}
