# Local gRPC server bind settings
GROCERY_DB_HOST=0.0.0.0
GROCERY_DB_PORT=50051
GROCERY_DB_PATH=/workspace/github/grocery.io/db_server/data/grocery.db
GROCERY_DB_PYTHON=/workspace/github/grocery.io/db_server/.venv/bin/python
GROCERY_AI_CHECKPOINT=/workspace/github/grocery.io/ai_server/outputs/local-run/best.pt

# Reverse tunnel settings
GROCERY_TUNNEL_HOST=endpoint.ip.address
GROCERY_TUNNEL_USER=endpoint-user
GROCERY_TUNNEL_KEY=path/to/your/ssh/key.pem
GROCERY_TUNNEL_REMOTE_PORT=50051
