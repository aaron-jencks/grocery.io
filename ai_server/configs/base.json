{
  "experiment_name": "price-tag-baseline",
  "dataset": {
    "labels_path": "data/labels.json",
    "train_manifest": "data/manifests/train.jsonl",
    "val_manifest": "data/manifests/val.jsonl",
    "image_root": "data/images",
    "val_ratio": 0.2,
    "min_train_samples": 1,
    "num_workers": 4
  },
  "model": {
    "backbone": "resnet18",
    "pretrained": false,
    "image_size": 224,
    "dropout": 0.1
  },
  "optimizer": {
    "name": "adamw",
    "lr": 0.0003,
    "weight_decay": 0.0001
  },
  "scheduler": {
    "name": "cosine",
    "min_lr": 0.000001
  },
  "train": {
    "seed": 1337,
    "device": "cuda",
    "batch_size": 32,
    "epochs": 50,
    "output_dir": "outputs/price-tag-baseline",
    "log_every_n_steps": 0,
    "save_every_n_epochs": 1
  }
}
